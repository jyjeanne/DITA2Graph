# The d2g vocabulary: classes and properties of the knowledge graph
# DITA2Graph builds from a DITA publication resolved by DITA-OT
# (docs/semantic-model.md). Kept within the OWL 2 RL profile: domains and
# ranges are broad and allow simple inferences; the validity rules live in
# the SHACL shapes (d2g-shapes.ttl), checked in a closed world.

@prefix d2g:     <https://w3id.org/dita2graph/ns#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<https://w3id.org/dita2graph/ns>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/dita2graph/ns/0.2.0> ;
    owl:versionInfo "0.2.0" ;
    owl:priorVersion <https://w3id.org/dita2graph/ns/0.1.1> ;
    rdfs:label "DITA2Graph vocabulary"@en , "Vocabulaire DITA2Graph"@fr ;
    rdfs:comment "Classes and properties of the knowledge graph DITA2Graph builds from a DITA publication resolved by DITA-OT."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://github.com/jyjeanne> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:modified "2026-11-12"^^xsd:date ;
    vann:preferredNamespacePrefix "d2g" ;
    vann:preferredNamespaceUri "https://w3id.org/dita2graph/ns#" ;
    rdfs:seeAlso <https://github.com/jyjeanne/DITA2Graph> .

# The header's own annotations (licence, creator, dates, preferred prefix
# for vocabulary catalogues such as LOV), declared so they stay annotation
# properties in OWL 2. dcterms:title and dcterms:description are data
# properties of the graph below, so the header uses rdfs:label and
# rdfs:comment instead: one IRI cannot be both.
dcterms:license a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:modified a owl:AnnotationProperty .
# Also the DITA metadata of the nodes (dates, authors): annotations, so a
# date that is not ISO 8601 stays valid as a plain string.
dcterms:available a owl:AnnotationProperty .
dcterms:contributor a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .

# ---------------------------------------------------------------------------
# Annotation used on every relation of this vocabulary.

d2g:origin
    a owl:AnnotationProperty ;
    rdfs:label "origin"@en , "origine"@fr ;
    rdfs:comment "How DITA2Graph obtains a relation: \"declared\" (written by the author in the DITA source), \"derived\" (read from DITA-OT's resolved output) or \"inferred\" (a heuristic)."@en .

# ---------------------------------------------------------------------------
# Terms reused from other vocabularies, declared so the ontology stays in
# OWL 2 RL (Dublin Core and PROV-O publish some of them as plain
# rdf:Property).

skos:Concept a owl:Class .
skos:prefLabel a owl:AnnotationProperty .
skos:broader a owl:ObjectProperty .
prov:Activity a owl:Class .
prov:wasDerivedFrom a owl:ObjectProperty .
prov:wasGeneratedBy a owl:ObjectProperty .
prov:used a owl:ObjectProperty .
prov:endedAtTime a owl:DatatypeProperty .
dcterms:references a owl:ObjectProperty .
dcterms:identifier a owl:DatatypeProperty .
dcterms:title a owl:DatatypeProperty .
dcterms:description a owl:DatatypeProperty .

# ---------------------------------------------------------------------------
# Classes

d2g:Node
    a owl:Class ;
    rdfs:label "Node"@en , "Nœud"@fr ;
    rdfs:comment "A unit of the publication represented in the graph: the map, a topic or a table-of-contents heading."@en .

d2g:Map
    a owl:Class ;
    rdfs:subClassOf d2g:Node ;
    rdfs:label "Map"@en , "Map"@fr ;
    rdfs:comment "The input map of the publication (a map or a bookmap)."@en .

d2g:Topic
    a owl:Class ;
    rdfs:subClassOf d2g:Node ;
    rdfs:label "Topic"@en , "Topic"@fr ;
    rdfs:comment "A published DITA topic; the generic class when it is not one of the specialized types below."@en .

d2g:Concept
    a owl:Class ;
    rdfs:subClassOf d2g:Topic ;
    rdfs:label "Concept"@en , "Concept"@fr ;
    rdfs:comment "A DITA concept topic."@en .

d2g:Task
    a owl:Class ;
    rdfs:subClassOf d2g:Topic ;
    rdfs:label "Task"@en , "Tâche"@fr ;
    rdfs:comment "A DITA task topic."@en .

d2g:Reference
    a owl:Class ;
    rdfs:subClassOf d2g:Topic ;
    rdfs:label "Reference"@en , "Référence"@fr ;
    rdfs:comment "A DITA reference topic."@en .

d2g:GlossEntry
    a owl:Class ;
    rdfs:subClassOf d2g:Topic , skos:Concept ;
    rdfs:label "Glossary entry"@en , "Entrée de glossaire"@fr ;
    rdfs:comment "A DITA glossentry topic: a defined term, hence also a skos:Concept."@en .

d2g:Troubleshooting
    a owl:Class ;
    rdfs:subClassOf d2g:Topic ;
    rdfs:label "Troubleshooting"@en , "Dépannage"@fr ;
    rdfs:comment "A DITA troubleshooting topic."@en .

d2g:TopicHead
    a owl:Class ;
    rdfs:subClassOf d2g:Node ;
    rdfs:label "Topic head"@en , "Titre de table des matières"@fr ;
    rdfs:comment "A titled table-of-contents entry with no topic of its own: a topichead, a navtitle-only bookmap chapter."@en .

d2g:Fragment
    a owl:Class ;
    rdfs:label "Fragment"@en , "Fragment"@fr ;
    rdfs:comment "An element of a topic that other topics reuse, named by its @id (or a fallback name when it has none)."@en .

d2g:Reuse
    a owl:Class ;
    rdfs:label "Reuse"@en , "Réutilisation"@fr ;
    rdfs:comment "One reuse: which topic pulls which fragments from which source topic."@en .

d2g:Key
    a owl:Class ;
    rdfs:label "Key"@en , "Clé"@fr ;
    rdfs:comment "A DITA key, defined in a map within a key scope."@en .

d2g:ExternalResource
    a owl:Class ;
    rdfs:label "External resource"@en , "Ressource externe"@fr ;
    rdfs:comment "A resource outside the corpus, named by its URL."@en .

d2g:SourceFile
    a owl:Class ;
    rdfs:label "Source file"@en , "Fichier source"@fr ;
    rdfs:comment "A file of the DITA source: a topic, a map or an included sample file."@en .

[] a owl:AllDisjointClasses ;
   owl:members ( d2g:Concept d2g:Task d2g:Reference d2g:GlossEntry d2g:Troubleshooting ) .

[] a owl:AllDisjointClasses ;
   owl:members ( d2g:Map d2g:Topic d2g:TopicHead ) .

# ---------------------------------------------------------------------------
# Object properties

d2g:contains
    a owl:ObjectProperty , owl:AsymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:label "contains"@en , "contient"@fr ;
    rdfs:comment "In the published table of contents, the object is a direct child of the subject. Navigation, not dependency."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range d2g:Node ;
    owl:inverseOf d2g:containedIn ;
    d2g:origin "declared" .

d2g:containedIn
    a owl:ObjectProperty ;
    rdfs:label "contained in"@en , "contenu dans"@fr ;
    rdfs:comment "Inverse of d2g:contains."@en ;
    d2g:origin "declared" .

d2g:references
    a owl:ObjectProperty ;
    rdfs:subPropertyOf dcterms:references ;
    rdfs:label "references"@en , "renvoie à"@fr ;
    rdfs:comment "The subject links to the object for the reader to consult; no order is implied. From xref and link, including relationship-table links."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range d2g:Node ;
    d2g:origin "declared" .

d2g:requires
    a owl:ObjectProperty ;
    rdfs:subPropertyOf d2g:references ;
    rdfs:label "requires"@en , "demande au préalable"@fr ;
    rdfs:comment "The subject task can only be done after reading or doing the object: a link in the task's prereq, or a link of the task marked importance=\"required\"."@en ;
    rdfs:domain d2g:Task ;
    rdfs:range d2g:Topic ;
    owl:inverseOf d2g:prerequisiteFor ;
    d2g:origin "declared" .

d2g:prerequisiteFor
    a owl:ObjectProperty ;
    rdfs:label "prerequisite for"@en , "prérequis de"@fr ;
    rdfs:comment "Inverse of d2g:requires."@en ;
    d2g:origin "declared" .

d2g:relatedTo
    a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "related to"@en , "lié à"@fr ;
    rdfs:comment "Both topics are about the same product: a hint, not an author's statement."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range d2g:Topic ;
    d2g:origin "inferred" .

d2g:appliesTo
    a owl:ObjectProperty ;
    rdfs:label "applies to"@en , "s'applique à"@fr ;
    rdfs:comment "The task operates a user-interface element the reference describes."@en ;
    rdfs:domain d2g:Task ;
    rdfs:range d2g:Reference ;
    d2g:origin "inferred" .

d2g:generatedFrom
    a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:label "generated from"@en , "reprend du contenu de"@fr ;
    rdfs:comment "Part of the subject's published content comes from the object, through conref or conkeyref: changing the object changes the subject."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range d2g:Topic ;
    d2g:origin "derived" .

d2g:copyOf
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:label "copy of"@en , "copie de"@fr ;
    rdfs:comment "The subject is a copy DITA-OT writes of the object under another name: a copy-to copy, or a branch-filtering copy (a ditavalref with a resource prefix or suffix). Derived from it, not a d2g:generatedFrom: a copy names no reused fragments (the extractor states the generatedFrom of its content separately)."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range d2g:Topic ;
    d2g:origin "derived" .

d2g:qualifiedReuse
    a owl:ObjectProperty ;
    rdfs:label "qualified reuse"@en , "réutilisation qualifiée"@fr ;
    rdfs:comment "Qualifies a d2g:generatedFrom with the fragments it reuses."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range d2g:Reuse ;
    d2g:origin "derived" .

d2g:reuseSource
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "reuse source"@en , "source de la réutilisation"@fr ;
    rdfs:domain d2g:Reuse ;
    rdfs:range d2g:Topic ;
    d2g:origin "derived" .

d2g:reusedFragment
    a owl:ObjectProperty ;
    rdfs:label "reused fragment"@en , "fragment réutilisé"@fr ;
    rdfs:domain d2g:Reuse ;
    rdfs:range d2g:Fragment ;
    d2g:origin "derived" .

d2g:fragmentOf
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fragment of"@en , "fragment de"@fr ;
    rdfs:comment "The topic that holds the fragment."@en ;
    rdfs:domain d2g:Fragment ;
    rdfs:range d2g:Topic ;
    d2g:origin "derived" .

d2g:definesKey
    a owl:ObjectProperty ;
    rdfs:label "defines key"@en , "définit la clé"@fr ;
    rdfs:domain d2g:Map ;
    rdfs:range d2g:Key ;
    owl:inverseOf d2g:definedIn ;
    d2g:origin "declared" .

d2g:definedIn
    a owl:ObjectProperty ;
    rdfs:label "defined in"@en , "définie dans"@fr ;
    rdfs:comment "Inverse of d2g:definesKey."@en ;
    d2g:origin "declared" .

d2g:keyTarget
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "key target"@en , "cible de la clé"@fr ;
    rdfs:comment "What the key names: a topic or an external resource. A key's IRI includes its scope, so it has one target."@en ;
    rdfs:domain d2g:Key ;
    d2g:origin "declared" .

d2g:usesKey
    a owl:ObjectProperty ;
    rdfs:label "uses key"@en , "utilise la clé"@fr ;
    rdfs:comment "The topic links to or reuses content through the key (keyref, conkeyref)."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range d2g:Key ;
    d2g:origin "declared" .

d2g:linksTo
    a owl:ObjectProperty ;
    rdfs:label "links to"@en , "pointe vers"@fr ;
    rdfs:comment "The topic links to a URL outside the corpus."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range d2g:ExternalResource ;
    d2g:origin "declared" .

d2g:includesCode
    a owl:ObjectProperty ;
    rdfs:label "includes code"@en , "inclut le fichier"@fr ;
    rdfs:comment "The topic shows the content of a sample file (coderef)."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range d2g:SourceFile ;
    d2g:origin "declared" .

d2g:sourceFile
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "source file"@en , "fichier source"@fr ;
    rdfs:comment "The file a node comes from, or the map file that defines a key. No domain: a node and a key share it, and OWL 2 RL allows no union as a domain."@en ;
    rdfs:range d2g:SourceFile ;
    d2g:origin "derived" .

d2g:indexTerm
    a owl:ObjectProperty ;
    rdfs:label "index term"@en , "entrée d'index"@fr ;
    rdfs:comment "An entry of the publication's index (an indexterm, prolog or body) that leads to the node. Each entry is a SKOS concept, labelled with its own words and under its broader term (skos:broader): the index as a concept hierarchy, shared by every node indexed under the same entry."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range skos:Concept ;
    d2g:origin "declared" .

# ---------------------------------------------------------------------------
# Datatype properties

d2g:audience
    a owl:DatatypeProperty ;
    rdfs:label "audience"@en , "public"@fr ;
    rdfs:domain d2g:Topic ;
    rdfs:range xsd:string .

d2g:product
    a owl:DatatypeProperty ;
    rdfs:label "product"@en , "produit"@fr ;
    rdfs:domain d2g:Topic ;
    rdfs:range xsd:string .

d2g:processingRole
    a owl:DatatypeProperty ;
    rdfs:label "processing role"@en , "rôle de traitement"@fr ;
    rdfs:comment "\"resource-only\" when every topicref naming the topic is resource-only: a reuse warehouse or a key target, outside the table of contents."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range xsd:string .

d2g:ditaClass
    a owl:DatatypeProperty ;
    rdfs:label "DITA class"@en , "classe DITA"@fr ;
    rdfs:comment "The full @class value of the topic's root element, which keeps its specialization."@en ;
    rdfs:domain d2g:Topic ;
    rdfs:range xsd:string .

d2g:keyName
    a owl:DatatypeProperty ;
    rdfs:label "key name"@en , "nom de clé"@fr ;
    rdfs:domain d2g:Key ;
    rdfs:range xsd:string .

d2g:keyText
    a owl:DatatypeProperty ;
    rdfs:label "key text"@en , "texte de la clé"@fr ;
    rdfs:comment "The text a key stands for (its keyword, link text or navtitle) when it names no topic: the value of a variable key, the label of a URL key."@en ;
    rdfs:domain d2g:Key ;
    rdfs:range xsd:string .

d2g:path
    a owl:DatatypeProperty ;
    rdfs:label "path"@en , "chemin"@fr ;
    rdfs:comment "The file's path relative to the publication's root, with forward slashes; never absolute."@en ;
    rdfs:domain d2g:SourceFile ;
    rdfs:range xsd:string .

d2g:okfConcept
    a owl:DatatypeProperty ;
    rdfs:label "OKF concept"@en , "concept OKF"@fr ;
    rdfs:comment "Path of the node's OKF concept file in the bundle (okf/topics/<id>.md, okf/maps/<id>.md)."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range xsd:string .

d2g:expiry
    a owl:DatatypeProperty ;
    rdfs:label "expiry"@en , "date d'expiration"@fr ;
    rdfs:comment "The date after which the content no longer applies (critdates @expiry, of the most recent revision that gives one). An xsd:date when written as ISO 8601, a plain string otherwise. Its other dates are Dublin Core: dcterms:created, dcterms:modified (the most recent revision) and dcterms:available (@golive)."@en ;
    rdfs:domain d2g:Node .

d2g:permissions
    a owl:DatatypeProperty ;
    rdfs:label "permissions"@en , "droits"@fr ;
    rdfs:comment "Who may see the content: the @view of the prolog's permissions (internal, classified, all, entitled...)."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range xsd:string .

d2g:productName
    a owl:DatatypeProperty ;
    rdfs:label "product name"@en , "nom du produit"@fr ;
    rdfs:comment "A product the content documents, from the prolog's prodinfo/prodname. Not d2g:product, which holds the @product profiling values."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range xsd:string .

d2g:productVersion
    a owl:DatatypeProperty ;
    rdfs:label "product version"@en , "version du produit"@fr ;
    rdfs:comment "A version of the documented product, joined from a prodinfo/vrm: version, release and modification (4.2.1)."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range xsd:string .

d2g:audienceType
    a owl:DatatypeProperty ;
    rdfs:label "audience type"@en , "type de public"@fr ;
    rdfs:comment "The prolog audience's @type (user, administrator, programmer...; @othertype for other). Not d2g:audience, which holds the @audience profiling values."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range xsd:string .

d2g:audienceJob
    a owl:DatatypeProperty ;
    rdfs:label "audience job"@en , "tâche du public"@fr ;
    rdfs:comment "The prolog audience's @job (installing, programming, troubleshooting...; @otherjob for other)."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range xsd:string .

d2g:experienceLevel
    a owl:DatatypeProperty ;
    rdfs:label "experience level"@en , "niveau d'expérience"@fr ;
    rdfs:comment "The prolog audience's @experiencelevel (novice, general, expert)."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range xsd:string .

d2g:keyword
    a owl:DatatypeProperty ;
    rdfs:label "keyword"@en , "mot-clé"@fr ;
    rdfs:comment "A keyword of the prolog's keywords. Its index terms are d2g:indexTerm."@en ;
    rdfs:domain d2g:Node ;
    rdfs:range xsd:string .

d2g:generator
    a owl:DatatypeProperty ;
    rdfs:label "generator"@en , "générateur"@fr ;
    rdfs:comment "Name and version of the program that ran the build."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:string .
