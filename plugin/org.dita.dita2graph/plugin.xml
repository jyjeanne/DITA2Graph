<?xml version="1.0" encoding="UTF-8"?>
<!--
  org.dita.dita2graph -- DITA-OT plugin layer (docs/plugin-specification.md §2).

  NOT YET VALIDATED against a live DITA-OT install: this environment has
  no `dita` binary and downloading/installing DITA-OT 4.4 (§1.1) hasn't
  been attempted yet (see docs/dev/phase-0-findings.md). The Rust side
  (core/, mcp/) is real, built, and tested; this XML is a best-effort
  skeleton following documented DITA-OT plugin conventions, and is the
  next concrete Phase 1 step: `dita --install .` against this directory,
  then `dita --format dita2graph` against sample-docs/user-guide.ditamap.
-->
<plugin id="org.dita.dita2graph">
  <!-- The standard preprocessing pipeline (key-space resolution,
       conref/conkeyref resolution, DITAVAL filtering) this transtype
       hooks into after (§2.2). -->
  <require plugin="org.dita.base"/>

  <!-- Registers the `dita2graph` transtype (§2.3: `dita --format dita2graph`). -->
  <feature extension="dita.transtype" value="dita2graph"/>
  <feature extension="dita.conductor.transtype.check" file="build.xml">
    <param name="transtype" value="dita2graph"/>
  </feature>

  <!-- Puts dita2graph-core.jar (the Java bridge to the Rust core engine,
       §2.1/§3.1 -- currently empty, see lib/README.md) on the Ant
       classpath for build.xml's extraction task. -->
  <feature extension="dita.conductor.lib.import" file="lib/dita2graph-core.jar" type="ant-typedef"/>

  <!-- Registers this plugin's message catalog (§2.5) alongside DITA-OT's own. -->
  <feature extension="dita.xsl.messages" file="cfg/messages.xml"/>
</plugin>
