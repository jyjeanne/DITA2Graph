<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default configuration for the dita2graph transtype
  (docs/plugin-specification.md section 2.1, section 2.3). Values here are the
  documented defaults; override any of them per-build with an
  args.dita2graph.NAME=VALUE argument (section 2.3) or the equivalent Gradle
  properties block (section 8.2).
-->
<dita2graph-config>
  <param name="depth" default="unlimited"/>
  <param name="mcp" default="false"/>
  <param name="emit-graph-json" default="true"/>
  <param name="store" default="sqlite"/>
  <param name="include-drafts" default="false"/>
  <param name="rdf" default="false"/>
  <param name="rdf.base" default=""/>
</dita2graph-config>
